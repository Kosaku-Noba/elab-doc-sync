# each モード: 1 ファイル = 1 実験ノート
#
# elabftw:
#   url: "https://your-elabftw.example.com"
#   verify_ssl: false
#
# targets:
#   - docs_dir: "experiments/"
#     pattern: "*.md"
#     mode: each             # 1 ファイル = 1 エンティティ
#     entity: experiments    # 実験ノートとして送信
#
# ─────────────────────────────────────────────
# 複数チームへの送信（profiles + team 指定）:
#
# APIキーはチームごとに発行する必要があります。
# profiles に team を紐付けておけば、targets で team 名を指定するだけで
# 対応するAPIキーが自動的に選ばれます。
#
# profiles:
#   cellstats:
#     url: "https://your-elabftw.example.com"
#     api_key: "59-xxxx..."
#     team: "CellStats"           # このキーが紐づくチーム
#   membrane:
#     url: "https://your-elabftw.example.com"
#     api_key: "60-yyyy..."
#     team: "高耐久膜チーム"
#
# targets:
#   - docs_dir: "docs/"
#     pattern: "*.md"
#     mode: each
#     entity: items
#     team: "CellStats"           # ← チーム名で送信先を指定
#
#   - docs_dir: "membrane_docs/"
#     pattern: "*.md"
#     mode: each
#     entity: items
#     team: "高耐久膜チーム"       # ← 別チームへ送信
#
# ※ team はチーム名（文字列）または ID（数値）で指定可能
# ※ esync whoami で各APIキーのアクティブチームを確認できます
#
# ─────────────────────────────────────────────
# 複数ターゲットの組み合わせ例:
#
# elabftw:
#   url: "https://your-elabftw.example.com"
#   verify_ssl: false
#
# targets:
#   # 紐付け・同期状態は docs_dir ごとに .elab-sync-ids/<docs_dir>/ へ自動で分けて保存される。
#   # id_file を指定する場合は、ターゲットごとに親ディレクトリを分けること
#   # （例: .elab-sync-ids/overview/default.id）。
#
#   # プロジェクトのドキュメントを 1 ファイル = 1 アイテムで送る
#   - title: "プロジェクト概要"
#     docs_dir: "docs/"
#     pattern: "*.md"
#     mode: each
#     entity: items
#     body_format: md            # md: Markdown のまま送信（デフォルト） / html: HTML に変換して送信
#     attachments_dir: "attachments/"  # 画像以外の添付ファイルディレクトリ（省略可）
#     tags:                      # push 時に自動追加するタグ（追記のみ）
#       - "プロジェクトA"
#       - "2026Q2"
#
#   # 各実験記録を個別の実験ノートとして送る
#   - docs_dir: "experiments/"
#     pattern: "*.md"
#     mode: each
#     entity: experiments
#
#   # 特定のディレクトリのファイルだけ送る
#   - title: "HPO 実験まとめ"
#     docs_dir: "hpo/"
#     pattern: "*HPO*.md"
#     mode: each
#     entity: items

elabftw:
  url: "https://your-elabftw.example.com"
  api_key: ""    # eLabFTW の API キーをここに記入（環境変数 ELABFTW_API_KEY が優先）
  verify_ssl: false

targets:
  - title: "My Documentation"
    docs_dir: "docs/"
    pattern: "*.md"
