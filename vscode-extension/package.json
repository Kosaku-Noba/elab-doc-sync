{
  "name": "esync",
  "displayName": "esync for eLabFTW",
  "description": "Markdown の差分確認、文書単位の push、eLabFTW との同期状態の表示",
  "version": "0.3.0",
  "license": "MIT",
  "publisher": "elab-doc-sync",
  "repository": { "type": "git", "url": "https://github.com/Kosaku-Noba/elab-doc-sync.git", "directory": "vscode-extension" },
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Other"],
  "main": "./extension.js",
  "extensionKind": ["workspace"],
  "capabilities": {
    "untrustedWorkspaces": { "supported": false },
    "virtualWorkspaces": { "supported": false }
  },
  "activationEvents": ["onStartupFinished"],
  "files": ["extension.js", "status.js", "articles.js", "cli.js", "media/esync.svg", "README.md", "LICENSE.txt"],
  "scripts": {
    "check": "tsc -p jsconfig.json",
    "test": "node test/run.cjs",
    "package": "vsce package --no-dependencies --out dist/",
    "prepackage": "node -e \"require('node:fs').mkdirSync('dist', { recursive: true })\""
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "1.85.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "4.1.1",
    "typescript": "^5.9.3"
  },
  "contributes": {
    "commands": [
      { "command": "esync.openArticle", "category": "esync", "title": "eLabFTW で開く", "icon": "$(link-external)" },
      { "command": "esync.editArticle", "category": "esync", "title": "タグ・リンクを追加、またはメタデータを設定", "icon": "$(edit)" },
      { "command": "esync.removeArticleEntry", "category": "esync", "title": "タグ・リンクを外す", "icon": "$(remove)" },
      { "command": "esync.newDocument", "category": "esync", "title": "テンプレートから新規文書を作成", "icon": "$(new-file)" },
      { "command": "esync.log", "category": "esync", "title": "同期ログを表示", "icon": "$(history)" },
      { "command": "esync.preview", "category": "esync", "title": "この文書の差分を確認", "icon": "$(diff)" },
      { "command": "esync.previewFromPanel", "category": "esync", "title": "この文書の差分を確認", "icon": "$(diff)" },
      { "command": "esync.push", "category": "esync", "title": "この差分の文書を push", "icon": "$(cloud-upload)", "enablement": "resourceScheme == esync-preview" },
      { "command": "esync.refresh", "category": "esync", "title": "同期状態を更新", "icon": "$(refresh)" },
      { "command": "esync.showRemoteChanges", "category": "esync", "title": "eLabFTW 側の変更を表示", "icon": "$(cloud)" },
      { "command": "esync.previewFromStatusBar", "category": "esync", "title": "この文書の差分を確認", "icon": "$(diff)" },
      { "command": "esync.pull", "category": "esync", "title": "eLabFTW の変更を取り込む", "icon": "$(cloud-download)" },
      { "command": "esync.adoptLocal", "category": "esync", "title": "ローカルの内容で eLabFTW を上書き（push --force）" },
      { "command": "esync.adoptRemote", "category": "esync", "title": "eLabFTW の内容でローカルを上書き（pull --force）" },
      { "command": "esync.showBackups", "category": "esync", "title": "バックアップの一覧を表示" }
    ],
    "viewsContainers": {
      "activitybar": [{ "id": "esync", "title": "esync", "icon": "media/esync.svg" }]
    },
    "views": {
      "esync": [
        { "id": "esync.current", "name": "開いている文書", "when": "esync.hasProjects" },
        { "id": "esync.status", "name": "プロジェクト全体の同期一覧", "when": "esync.hasProjects" }
      ]
    },
    "menus": {
      "editor/title": [
        { "command": "esync.preview", "when": "esync.hasProjects && resourceLangId == markdown && (resourceScheme == file || resourceScheme == vscode-remote)", "group": "navigation" },
        { "command": "esync.push", "when": "resourceScheme == esync-preview", "group": "navigation" }
      ],
      "commandPalette": [
        { "command": "esync.log", "when": "esync.hasProjects" },
        { "command": "esync.newDocument", "when": "esync.hasProjects" },
        { "command": "esync.removeArticleEntry", "when": "false" },
        { "command": "esync.editArticle", "when": "false" },
        { "command": "esync.openArticle", "when": "false" },
        { "command": "esync.previewFromPanel", "when": "false" },
        { "command": "esync.showRemoteChanges", "when": "false" },
        { "command": "esync.previewFromStatusBar", "when": "false" },
        { "command": "esync.pull", "when": "esync.hasProjects && resourceLangId == markdown" },
        { "command": "esync.adoptLocal", "when": "false" },
        { "command": "esync.adoptRemote", "when": "false" },
        { "command": "esync.showBackups", "when": "esync.hasProjects" },
        { "command": "esync.preview", "when": "esync.hasProjects && resourceLangId == markdown" },
        { "command": "esync.push", "when": "resourceScheme == esync-preview" },
        { "command": "esync.refresh", "when": "esync.hasProjects" }
      ],
      "view/title": [
        { "command": "esync.newDocument", "when": "view == esync.current", "group": "navigation" },
        { "command": "esync.log", "when": "view == esync.status" },
        { "command": "esync.refresh", "when": "view == esync.status || view == esync.current", "group": "navigation" }],
      "view/item/context": [
        { "command": "esync.openArticle", "when": "view == esync.status && viewItem =~ /article/", "group": "inline" },
        { "command": "esync.editArticle", "when": "view == esync.current && (viewItem =~ /esync[.]group[.]/ || viewItem == esync.entry.metadata)", "group": "1_article" },
        { "command": "esync.removeArticleEntry", "when": "view == esync.current && (viewItem == esync.entry.tag || viewItem == esync.entry.relate)", "group": "1_article" },
        { "command": "esync.previewFromPanel", "when": "view == esync.status && viewItem =~ /esync\\.document/", "group": "inline" },
        { "command": "esync.pull", "when": "view == esync.status && viewItem =~ /\\bpull\\b/", "group": "inline" },
        { "command": "esync.pull", "when": "view == esync.status && viewItem =~ /\\bpull\\b/", "group": "1_sync@1" },
        { "command": "esync.adoptLocal", "when": "view == esync.status && viewItem =~ /\\bconflict\\b/", "group": "2_adopt@1" },
        { "command": "esync.adoptRemote", "when": "view == esync.status && viewItem =~ /\\b(conflict|markers)\\b/", "group": "2_adopt@2" }
      ]
    },
    "configuration": {
      "title": "esync",
      "properties": {
        "esync.executable": {
          "type": "string",
          "default": "esync",
          "scope": "machine",
          "description": "esync CLI の実行ファイル名または絶対パス。"
        },
        "esync.timeoutSeconds": {
          "type": "number",
          "default": 120,
          "minimum": 0,
          "description": "同期状態や差分の取得を打ち切るまでの秒数。0 にすると打ち切りません。push でも送信前の差分確認にはこの秒数を適用し、送信開始後は時間で打ち切りません。起動時の版の確認は 30 秒で打ち切ります。"
        }
      }
    }
  }
}
