{
  "name": "esync",
  "displayName": "esync for eLabFTW",
  "description": "Markdown の差分確認、文書単位の push、eLabFTW との同期状態の表示",
  "version": "0.3.0",
  "publisher": "elab-doc-sync",
  "repository": { "type": "git", "url": "https://github.com/Kosaku-Noba/elab-doc-sync.git", "directory": "vscode-extension" },
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Other"],
  "main": "./extension.js",
  "extensionKind": ["workspace"],
  "capabilities": {
    "untrustedWorkspaces": { "supported": false },
    "virtualWorkspaces": { "supported": false }
  },
  "activationEvents": ["onStartupFinished"],
  "files": ["extension.js", "status.js", "cli.js", "media/esync.svg", "README.md"],
  "scripts": { "check": "tsc -p jsconfig.json", "test": "node test/run.cjs" },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "1.85.0",
    "@vscode/test-electron": "^3.1.0",
    "typescript": "^5.9.3"
  },
  "contributes": {
    "commands": [
      { "command": "esync.preview", "category": "esync", "title": "この文書の差分を確認", "icon": "$(diff)" },
      { "command": "esync.previewFromPanel", "category": "esync", "title": "この文書の差分を確認", "icon": "$(diff)" },
      { "command": "esync.push", "category": "esync", "title": "この差分の文書を push", "icon": "$(cloud-upload)", "enablement": "resourceScheme == esync-preview" },
      { "command": "esync.refresh", "category": "esync", "title": "同期状態を更新", "icon": "$(refresh)" }
    ],
    "viewsContainers": {
      "activitybar": [{ "id": "esync", "title": "esync", "icon": "media/esync.svg" }]
    },
    "views": {
      "esync": [
        { "id": "esync.current", "name": "開いている文書", "when": "esync.hasProjects" },
        { "id": "esync.status", "name": "プロジェクト全体の同期一覧", "when": "esync.hasProjects" }
      ]
    },
    "menus": {
      "editor/title": [
        { "command": "esync.preview", "when": "esync.hasProjects && resourceLangId == markdown && (resourceScheme == file || resourceScheme == vscode-remote)", "group": "navigation" },
        { "command": "esync.push", "when": "resourceScheme == esync-preview", "group": "navigation" }
      ],
      "commandPalette": [
        { "command": "esync.previewFromPanel", "when": "false" },
        { "command": "esync.preview", "when": "esync.hasProjects && resourceLangId == markdown" },
        { "command": "esync.push", "when": "resourceScheme == esync-preview" },
        { "command": "esync.refresh", "when": "esync.hasProjects" }
      ],
      "view/title": [{ "command": "esync.refresh", "when": "view == esync.status || view == esync.current", "group": "navigation" }],
      "view/item/context": [{ "command": "esync.previewFromPanel", "when": "view == esync.status && viewItem == esync.document", "group": "inline" }]
    },
    "configuration": {
      "title": "esync",
      "properties": {
        "esync.executable": {
          "type": "string",
          "default": "esync",
          "scope": "machine",
          "description": "esync CLI の実行ファイル名または絶対パス。"
        },
        "esync.timeoutSeconds": {
          "type": "number",
          "default": 120,
          "minimum": 0,
          "description": "同期状態や差分の取得を打ち切るまでの秒数。0 にすると打ち切りません。push は時間で打ち切りません。"
        }
      }
    }
  }
}
